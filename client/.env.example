# Supabase Project Configuration (Frontend - Public/Publishable values only)
# Find these in Supabase Dashboard -> Project Settings -> API / Data API & API Keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# IMPORTANT: Never add SUPABASE_SERVICE_ROLE_KEY or any secret key here.
# Any variable starting with VITE_ is bundled into public browser code.
